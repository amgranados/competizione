# docker-compose environment overrides. Copy to `.env` to apply.

# Postgres
POSTGRES_USER=competizione
POSTGRES_PASSWORD=competizione
POSTGRES_DB=competizione

# Backend (FastAPI)
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
COOKIES_SECURE=false
RIOT_API_KEY=RGAPI-15d35bed-41aa-4b84-8755-cbef3ea6ff74

# Frontend (Vite, baked at build time)
VITE_API_BASE_URL=http://localhost:8000
