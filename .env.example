# docker-compose environment overrides. Copy to `.env` to apply.
# =====================================================================
# PERFIL DEV (valores por defecto, pensados para localhost sobre HTTP).
# Para producción, ver el bloque comentado al final y docker-compose.prod.yml.
# =====================================================================

# Postgres
POSTGRES_USER=competizione
# DEV ONLY: en producción usa una contraseña fuerte y NO la versiones.
POSTGRES_PASSWORD=competizione
POSTGRES_DB=competizione

# Backend (FastAPI)
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
COOKIES_SECURE=false
ENVIRONMENT=development
# IP/red del reverse proxy del que confiar X-Forwarded-For para el rate-limit.
# En dev (sin proxy) basta loopback; NUNCA usar "*".
FORWARDED_ALLOW_IPS=127.0.0.1
# Obtén la tuya en https://developer.riotgames.com — NO la commitees (las dev keys caducan en 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Frontend (Vite, baked at build time)
VITE_API_BASE_URL=http://localhost:8000

# =====================================================================
# PERFIL PRODUCCIÓN (descomentar/ajustar; usar con docker-compose.prod.yml).
# Sirve siempre sobre HTTPS detrás de un reverse proxy que termine TLS.
# =====================================================================
# POSTGRES_PASSWORD=<contraseña-fuerte-aleatoria>     # obligatoria, sin default
# SECRET_KEY=<32+ chars aleatorios y secretos>
# FRONTEND_ORIGIN=https://tu-dominio.example
# COOKIES_SECURE=true
# ENVIRONMENT=production
# FORWARDED_ALLOW_IPS=<ip-o-red-del-reverse-proxy>
# VITE_API_BASE_URL=https://api.tu-dominio.example
# RIOT_API_KEY=<tu-clave-de-produccion>               # nunca versionar
