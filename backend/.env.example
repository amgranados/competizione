DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/competizione
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173

# Feature 003 — operativa. Si esta definida, el factory devuelve HttpRiotAPIClient (consume Riot API real).
# Si esta vacia, el factory devuelve MockRiotAPIClient con log INFO explicito (utilidad: dev/CI sin red).
# Obtén la tuya en https://developer.riotgames.com — NO la commitees (las dev keys caducan en 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
